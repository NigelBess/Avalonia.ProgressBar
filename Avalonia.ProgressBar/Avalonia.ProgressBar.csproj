<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <PackageId>ProgressBar.Avalonia</PackageId>
    <Version>1.0.0</Version>
    <Description>A coin-earning game window (farming, casino and mining mini games) that can be opened from any Avalonia app.</Description>
    <PackageTags>avalonia;game</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the demo host use the testing aids (add coins, advance time) without making them public API. -->
    <InternalsVisibleTo Include="Avalonia.ProgressBar.Demo" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
  </ItemGroup>
</Project>
